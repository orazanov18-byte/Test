-- Функция создания большой кнопки для телефона
local function CreateBigButton(text, y, settingKey, defaultValue)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.92, 0, 0, 36)
    btn.Position = UDim2.new(0.04, 0, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 65)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.TextSize = 14
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 0
    btn.Parent = mainPanel

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    -- Статус (круг)
    local status = Instance.new("Frame")
    status.Size = UDim2.new(0, 18, 0, 18)
    status.Position = UDim2.new(1, -26, 0.5, -9)
    status.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    status.BorderSizePixel = 0
    status.Parent = btn

    local statusCorner = Instance.new("UICorner")
    statusCorner.CornerRadius = UDim.new(1, 0)
    statusCorner.Parent = status

    -- Статус текст (ON/OFF)
    local statusText = Instance.new("TextLabel")
    statusText.Size = UDim2.new(1, 0, 1, 0)
    statusText.BackgroundTransparency = 1
    statusText.Text = "OFF"
    statusText.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusText.TextSize = 8
    statusText.Font = Enum.Font.GothamBold
    statusText.Parent = status

    Settings[settingKey] = defaultValue ~= nil and defaultValue or false
    
    local function Update()
        if Settings[settingKey] then
            status.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
            statusText.Text = "ON"
        else
            status.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            statusText.Text = "OFF"
        end
    end
    Update()

    btn.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        Update()
        print(settingKey .. ": " .. tostring(Settings[settingKey]))
    end)

    return btn
end

