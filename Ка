-- ====== AUTO FARM ======
-- =====================================
if Settings.AutoFarm then
    runService.RenderStepped:Connect(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Part") and (v.Name:find("Ring") or v.Name:find("Coin") or v.Name:find("Money") or v.Name:find("Crate") or v.Name:find("Box")) then
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (v.Position - player.Character.HumanoidRootPart.Position).magnitude
                    if dist < 25 then
                        local hrp = player.Character.HumanoidRootPart
                        local targetPos = v.Position + Vector3.new(0, 2, 0)
                        hrp.CFrame = CFrame.new(hrp.Position, targetPos)
                        hrp.Velocity = (targetPos - hrp.Position) * 4
                    end
                end
            end
        end
    end)
end

