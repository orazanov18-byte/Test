-- ===== AUTOFARM (слежка за убийцей) =====
if AutoFarm then
    local function FindMurderer()
        for _, v in pairs(GetPlayers()) do
            if v.Team and v.Team.Name == "Murderer" then
                return v
            end
        end
        return nil
    end
    
    -- Индикатор на экране
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 40, 0, 40)
    indicator.Position = UDim2.new(0.5, -20, 0.5, -20)
    indicator.BackgroundColor3 = Color3.new(1, 0, 0)
    indicator.BackgroundTransparency = 0.3
    indicator.Parent = screenGui
    indicator.Visible = false
    
    local indicatorCorner = Instance.new("UICorner")
    indicatorCorner.CornerRadius = UDim.new(1, 0)
    indicatorCorner.Parent = indicator
    
    -- Стрелка
    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(1, 0, 1, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "⬆"
    arrow.TextColor3 = Color3.new(1, 0, 0)
    arrow.TextSize = 30
    arrow.TextScaled = true
    arrow.Parent = indicator
    
    runService.RenderStepped:Connect(function()
        local murderer = FindMurderer()
        if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
            indicator.Visible = true
            local pos, onScreen = camera:WorldToScreenPoint(murderer.Character.HumanoidRootPart.Position)
            if onScreen then
                indicator.Position = UDim2.new(0, pos.X - 20, 0, pos.Y - 20)
                indicator.BackgroundColor3 = Color3.new(1, 0, 0)
                arrow.TextColor3 = Color3.new(1, 0, 0)
            else
                local dir = (murderer.Character.HumanoidRootPart.Position - camera.CFrame.Position).Unit
                local angle = math.atan2(dir.X, dir.Z)
                local x = 0.5 + math.sin(angle) * 0.4
                local y = 0.5 - math.cos(angle) * 0.4
                indicator.Position = UDim2.new(0, x * 1920 - 20, 0, y * 1080 - 20)
                indicator.BackgroundColor3 = Color3.new(1, 1, 0)
                arrow.TextColor3 = Color3.new(1, 1, 0)
            end
        else
            indicator.Visible = false
        end
    end)
end

-- ===== AIMBOT (автоматический) =====
if AimBot then
    local function GetClosest()
        local closest = nil
        local shortest = math.huge
        
        for _, v in pairs(GetPlayers()) do
            if v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                local pos, onScreen = camera:WorldToScreenPoint(v.Character.HumanoidRootPart.Position)
                if onScreen then
                    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                    local dist = (Vector2.new(pos.X, pos.Y) - center).magnitude
                    if dist < 500 and dist < shortest then
                        shortest = dist
                        closest = v
                    end
                end
            end
        end
        return closest
    end
    
    runService.RenderStepped:Connect(function()
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            -- Проверяем, является ли игрок убийцей (по оружию)
            local isMurderer = false
            for _, tool in pairs(player.Character:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name:find("Knife") or tool.Name:find("Gun") or tool.Name:find("Sword")) then
                    isMurderer = true
                end
            end
            
            if isMurderer then
                local target = GetClosest()
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    -- Плавно наводим камеру
                    local targetPos = target.Character.HumanoidRootPart.Position
                    local newCFrame = CFrame.new(camera.CFrame.Position, targetPos)
                    camera.CFrame = camera.CFrame:Lerp(newCFrame, 0.15)
                end
            end
        end
    end)
end

-- ===== SPEED HACK =====
if SpeedHack then
    runService.RenderStepped:Connect(function()
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = SpeedValue
        end
    end)
end

