buttonPanel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
buttonPanel.BackgroundTransparency = 0.5
buttonPanel.BorderSizePixel = 0
buttonPanel.Parent = screenGui

local panelCorner = Instance.new("UICorner")
