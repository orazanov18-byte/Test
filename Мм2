-- ===== ДЖОЙСТИК ДЛЯ ЦЕЛЕЙ =====
local isDragging = false
local startPos = Vector2.new(0, 0)

joystick.MouseButton1Down:Connect(function()
    isDragging = true
    startPos = Vector2.new(mouse.X, mouse.Y)
end)

userInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = false
    end
end)

runService.RenderStepped:Connect(function()
    if isDragging and AimBot then
        local delta = Vector2.new(mouse.X, mouse.Y) - startPos
        if delta.magnitude > 10 then
            -- Поворачиваем камеру в сторону движения пальца
            camera.CFrame = camera.CFrame * CFrame.Angles(0, -delta.X / 500, 0)
            startPos = Vector2.new(mouse.X, mouse.Y)
        end
    end
end)

