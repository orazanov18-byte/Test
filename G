-- ====== ОРУЖИЕ (КНОПКИ) ======
-- =====================================
local function GiveWeapon(weaponName)
    -- Сначала проверяем инвентарь
    for _, v in pairs(player.Backpack:GetChildren()) do
        if v:IsA("Tool") then
            v.Parent = player.Character
            player.Character.Humanoid:EquipTool(v)
            print("✅ Взято оружие: " .. v.Name)
            return
        end
    end
    
    -- Ищем в мире
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Tool") and v.Name:find(weaponName) then
            v.Parent = player.Character
            player.Character.Humanoid:EquipTool(v)
            print("✅ Взято оружие: " .. v.Name)
            return
        end
    end
    
    -- Ищем в ReplicatedStorage
    for _, v in pairs(replicatedStorage:GetDescendants()) do
        if v:IsA("Tool") and v.Name:find(weaponName) then
            local clone = v:Clone()
            clone.Parent = player.Character
            player.Character.Humanoid:EquipTool(clone)
            print("✅ Взято оружие: " .. v.Name)
            return
        end
    end
    
    print("❌ Оружие не найдено: " .. weaponName)
end

