-- ====== AIMBOT (НЕ РАБОТАЕТ НА СВОИХ) ======
-- =====================================

if Settings.Aimbot then
    local function GetClosest()
        local closest = nil
        local shortest = math.huge
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        
        -- Ищем ТОЛЬКО ВРАГОВ
        for _, v in pairs(GetEnemies()) do
            if v.Character then
                local targetPart = v.Character:FindFirstChild("Head")
                if not targetPart then
                    targetPart = v.Character:FindFirstChild("HumanoidRootPart")
                end
                
                if targetPart then
                    local pos, onScreen = camera:WorldToScreenPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - center).magnitude
                        if dist < 500 and dist < shortest then
                            shortest = dist
                            closest = v
                        end
                    end
                end
            end
        end
        return closest
    end
    
    -- Для телефона: постоянный аим на врагов
    runService.RenderStepped:Connect(function()
        if Settings.Aimbot then
            local target = GetClosest()
            if target and target.Character then
                -- Проверка, что это враг
                if IsEnemy(target) then
                    local targetPart = target.Character:FindFirstChild("Head")
                    if not targetPart then
                        targetPart = target.Character:FindFirstChild("HumanoidRootPart")
                    end
                    
                    if targetPart then
                        local targetPos = targetPart.Position
                        local newCFrame = CFrame.new(camera.CFrame.Position, targetPos)
                        camera.CFrame = camera.CFrame:Lerp(newCFrame, 0.2)
                    end
                end
            end
        end
    end)
    
    -- Для ПК: ПКМ только на врагов
    userInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if Settings.Aimbot and input.UserInputType == Enum.UserInputType.MouseButton2 then
            local target = GetClosest()
            if target and target.Character and IsEnemy(target) then
                local targetPart = target.Character:FindFirstChild("Head")
                if not targetPart then
                    targetPart = target.Character:FindFirstChild("HumanoidRootPart")
                end
                if targetPart then
                    camera.CFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
                end
            end
        end
    end)
end

-- =====================================
-- ====== ESP (РАЗНЫЙ ЦВЕТ ДЛЯ СВОИХ) ======
-- =====================================

if Settings.ESP then
    runService.RenderStepped:Connect(function()
        for _, v in pairs(GetAllPlayers()) do
            if v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                if not v.Character:FindFirstChild("ESPBox") then
                    local box = Instance.new("BoxHandleAdornment")
                    box.Name = "ESPBox"
                    box.Size = Vector3.new(4, 6, 1)
                    box.Adornee = v.Character.HumanoidRootPart
                    box.AlwaysOnTop = true
                    box.ZIndex = 0
                    box.Transparency = 0.3
                    
                    -- РАЗНЫЙ ЦВЕТ: враги - красные, свои - зелёные
                    if IsEnemy(v) then
                        box.Color3 = Color3.new(1, 0, 0) -- Враг (красный)
                    else
                        box.Color3 = Color3.new(0, 1, 0) -- Свой (зелёный)
                    end
                    box.Parent = v.Character.HumanoidRootPart
                    
                    -- Имя с указанием команды
                    local nameTag = Instance.new("BillboardGui")
                    nameTag.Name = "ESPName"
                    nameTag.Size = UDim2.new(0, 200, 0, 25)
                    nameTag.Adornee = v.Character.Head or v.Character.HumanoidRootPart
                    nameTag.Parent = v.Character.Head or v.Character.HumanoidRootPart
                    
                    local text = Instance.new("TextLabel")
                    text.Size = UDim2.new(1, 0, 1, 0)
                    text.BackgroundTransparency = 1
                    
                    -- Добавляем метку "TEAM" для своих
                    if IsEnemy(v) then
                        text.Text = v.Name .. " 🔴"
                        text.TextColor3 = Color3.new(1, 0, 0)
                    else
                        text.Text = v.Name .. " 🟢 TEAM"
                        text.TextColor3 = Color3.new(0, 1, 0)
                    end
                    text.TextScaled = true
                    text.Font = Enum.Font.GothamBold
                    text.Parent = nameTag
                end
            end
        end
    end)
end

