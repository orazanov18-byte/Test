-- Функция создания кнопки
local function CreateToggle(text, y, settingKey, defaultValue)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.Position = UDim2.new(0.05, 0, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 70)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.TextSize = 13
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 0
    btn.Parent = buttonPanel

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = btn

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(0, 25, 1, 0)
    status.Position = UDim2.new(1, -30, 0, 0)
    status.BackgroundTransparency = 1
    status.Text = "⬜"
    status.TextColor3 = Color3.fromRGB(255, 50, 50)
    status.TextSize = 14
    status.Parent = btn

    Settings[settingKey] = defaultValue ~= nil and defaultValue or false
    
    if Settings[settingKey] then
        status.Text = "✅"
        status.TextColor3 = Color3.fromRGB(50, 255, 50)
    else
        status.Text = "❌"
        status.TextColor3 = Color3.fromRGB(255, 50, 50)
    end

    btn.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        if Settings[settingKey] then
            status.Text = "✅"
            status.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            status.Text = "❌"
            status.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
        
        -- Обновляем статус TeamCheck
        if settingKey == "TeamCheck" then
            if Settings.TeamCheck then
                teamStatus.Text = "🛡️ Team Check: ON"
                teamStatus.TextColor3 = Color3.fromRGB(0, 255, 100)
            else
                teamStatus.Text = "⚠️ Team Check: OFF (бьёт всех)"
                teamStatus.TextColor3 = Color3.fromRGB(255, 200, 0)
            end
        end
        print(settingKey .. ": " .. tostring(Settings[settingKey]))
    end)

    return btn
end

