-- ===== ПРОВЕРКА КОМАНДЫ =====
local function IsEnemy(target)
    if not Settings.TeamCheck then return true end
    
    -- Проверяем через Team
    if target.Team and player.Team then
        if target.Team == player.Team then
            return false -- Свои!
        end
    end
    
    -- Проверка через имя команды (для некоторых игр)
    if target.TeamColor and player.TeamColor then
        if target.TeamColor == player.TeamColor then
            return false
        end
    end
    
    -- Дополнительная проверка через неймтеги
    if target.Team and player.Team then
        if target.Team.Name == player.Team.Name then
            return false
        end
    end
    
    -- Проверка через цвет (BloxStrike)
    local playerColor = player.Character and player.Character:FindFirstChild("Head") and player.Character.Head.BrickColor
    local targetColor = target.Character and target.Character:FindFirstChild("Head") and target.Character.Head.BrickColor
    
    if playerColor and targetColor then
        if playerColor == targetColor then
            return false
        end
    end
    
    return true -- Враг
end

-- Получить врагов (без тиммейтов)
local function GetEnemies()
    local list = {}
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            if IsEnemy(v) then -- ТОЛЬКО ВРАГИ!
                table.insert(list, v)
            end
        end
    end
    return list
end

-- Получить всех игроков (для ESP)
local function GetAllPlayers()
    local list = {}
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(list, v)
        end
    end
    return list
end

