-- =====================================
-- ====== AIMBOT ======
-- =====================================
if Settings.Aimbot then
    local function GetClosest()
        local closest = nil
        local shortest = math.huge
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        
        for _, v in pairs(GetEnemies()) do
            if v.Character then
                local targetPart = v.Character:FindFirstChild("Head") or v.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local pos, onScreen = camera:WorldToScreenPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - center).magnitude
                        if dist < 600 and dist < shortest then
                            shortest = dist
                            closest = v
                        end
                    end
                end
            end
        end
        return closest
    end
    
    runService.RenderStepped:Connect(function()
        if Settings.Aimbot then
            local target = GetClosest()
            if target and target.Character and IsEnemy(target) then
                local targetPart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    camera.CFrame = camera.CFrame:Lerp(
                        CFrame.new(camera.CFrame.Position, targetPart.Position),
                        0.18
                    )
                end
            end
        end
    end)
end

