-- Функция для восстановления здоровья
local function HealPlayer()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            -- Восстанавливаем здоровье
            humanoid.Health = humanoid.MaxHealth
            humanoid.BreakJointsOnDeath = false
            humanoid.AutoRotate = true
            
            -- Убираем эффекты смерти
            if char:FindFirstChild("ForceField") then
                char.ForceField:Destroy()
            end
        end
        
        -- Восстанавливаем части тела
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.Transparency = 0
                part.CanCollide = true
            end
        end
    end
end

-- Постоянное лечение
runService.RenderStepped:Connect(function()
    if Settings.GodMode or Settings.InfiniteHealth then
        local char = player.Character
        if char then
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                -- Мгновенное восстановление здоровья
                if humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
                humanoid.BreakJointsOnDeath = false
                
                -- Защита от падения
                if humanoid.Health <= 0 then
                    humanoid.Health = humanoid.MaxHealth
                end
            end
        end
    end
end)

-- Защита от смерти (событие)
if Settings.AntiDeath then
    local function onCharacterAdded(char)
        wait(0.1)
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.Health = humanoid.MaxHealth
            humanoid.BreakJointsOnDeath = false
            
            -- Отключаем смерть
            humanoid.Died:Connect(function()
                wait(0.1)
                humanoid.Health = humanoid.MaxHealth
                char:BreakJointsOnDeath = false
            end)
        end
    end
    
    -- При добавлении персонажа
    player.CharacterAdded:Connect(onCharacterAdded)
    
    -- Если персонаж уже есть
    if player.Character then
        onCharacterAdded(player.Character)
    end
end

-- Блокировка урона
local function blockDamage()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.Health = humanoid.MaxHealth
            humanoid.BreakJointsOnDeath = false
            
            -- Отключаем все уроны
            for _, v in pairs(char:GetChildren()) do
                if v:IsA("BasePart") then
                    v:SetAttribute("Health", 9999)
                end
            end
        end
    end
end

runService.Heartbeat:Connect(function()
    blockDamage()
end)

