-- СПОСОБ 1: Через Humanoid
local function GodMode()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            -- Главная защита
            humanoid.Health = 100
            humanoid.MaxHealth = 100
            humanoid.BreakJointsOnDeath = false
            humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Always
            
            -- Отключаем урон
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
            
            -- Авто-лечение
            humanoid.HealthChanged:Connect(function()
                if humanoid.Health < 100 then
                    humanoid.Health = 100
                end
            end)
            
            -- Блокировка смерти
            humanoid.Died:Connect(function()
                wait(0.1)
                humanoid.Health = 100
                char:BreakJointsOnDeath = false
            end)
        end
        
        -- Защита частей тела
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.Transparency = 0
                part.BrickColor = BrickColor.new("Bright red")
            end
        end
    end
end

-- Запуск бессмертия
player.CharacterAdded:Connect(function()
    wait(0.5)
    GodMode()
end)

if player.Character then
    GodMode()
end

-- Постоянная защита (каждый кадр)
runService.RenderStepped:Connect(function()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            if humanoid.Health < 100 then
                humanoid.Health = 100
            end
            humanoid.BreakJointsOnDeath = false
            
            -- Защита от падений
            if humanoid.Health <= 0 then
                humanoid.Health = 100
            end
        end
    end
end)

-- СПОСОБ 2: Через силу (на всякий случай)
local function ForceGod()
    local char = player.Character
    if char then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v:SetAttribute("Health", 9999)
                v:SetAttribute("MaxHealth", 9999)
            end
        end
    end
end

runService.Heartbeat:Connect(function()
    ForceGod()
end)

